# Public entry point. TRACKFOLIO_SITE (set in the caddy environment file in ~/trackfolio) is the
# domain: Caddy then obtains and renews a certificate by itself. Without it the site answers
# on plain HTTP (:80), for testing only.
{$TRACKFOLIO_SITE::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		# Scripts and styles stay unrestricted because pages use inline scripts and Plotly.
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	request_body {
		max_size 1MB
	}

	# Caddy keeps the original Host header, which the app's origin check relies on.
	reverse_proxy trackfolio-app:8000
}
