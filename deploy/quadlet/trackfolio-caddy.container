[Unit]
Description=TrackFolio HTTPS reverse proxy (Caddy)
Requires=trackfolio-app.service
After=trackfolio-app.service

[Container]
Image=docker.io/library/caddy:2
ContainerName=trackfolio-caddy
# Host network: rootless port publishing hides the client address behind a bridge network, and
# the app's per-IP rate limits need it. Caddy listens on 8080/8443 (firewalld forwards 80/443).
Network=host
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL
# The official binary carries the file capability cap_net_bind_service and will not start
# without it in the bounding set, even though only ports >= 1024 are used.
AddCapability=NET_BIND_SERVICE
Volume=%h/trackfolio/caddy:/etc/caddy:ro,Z
Volume=trackfolio-caddy-data.volume:/data
Volume=trackfolio-caddy-config.volume:/config
EnvironmentFile=%h/trackfolio/caddy.env

[Service]
Restart=always

[Install]
WantedBy=default.target
