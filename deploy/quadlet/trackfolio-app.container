[Unit]
Description=TrackFolio web application
Requires=trackfolio-db.service
After=trackfolio-db.service

[Container]
Image=localhost/trackfolio:latest
Pull=never
ContainerName=trackfolio-app
Network=trackfolio.network
EnvironmentFile=%h/trackfolio/app.env
EnvironmentFile=%h/trackfolio/web.env
HealthCmd=python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"
HealthInterval=30s
HealthStartPeriod=30s
HealthOnFailure=kill
ReadOnly=true
Environment=XDG_CACHE_HOME=/tmp
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always

[Install]
WantedBy=default.target
